<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <title><%= seo_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= seo_description %>">
    <meta name="robots" content="<%= content_for?(:seo_robots) ? yield(:seo_robots) : "index, follow, max-image-preview:large" %>">
    <link rel="canonical" href="<%= seo_canonical %>">
    <meta name="theme-color" content="#131413">
    <meta name="mobile-web-app-capable" content="yes">

    <meta property="og:site_name" content="<%= SeoHelper::SITE_NAME %>">
    <meta property="og:locale" content="es_ES">
    <meta property="og:type" content="<%= content_for?(:seo_type) ? yield(:seo_type) : "website" %>">
    <meta property="og:title" content="<%= seo_title %>">
    <meta property="og:description" content="<%= seo_description %>">
    <meta property="og:url" content="<%= seo_canonical %>">
    <meta property="og:image" content="<%= seo_image %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= seo_title %>">
    <meta name="twitter:description" content="<%= seo_description %>">
    <meta name="twitter:image" content="<%= seo_image %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..600;1,6..96,400..600&amp;family=Geist:wght@400..600&amp;display=swap">

    <%= yield :head %>

    <%= stylesheet_pack_tag "application", "data-turbolinks-track": "reload" %>
    <%= javascript_pack_tag "application", "data-turbolinks-track": "reload" %>

    <%= organization_json_ld %>

    <!-- Umami Analytics -->
    <% if (umami_id = Rails.application.credentials.dig(:unami, :arcanmotors_id).presence) %>
      <script defer src="https://cloud.umami.is/script.js" data-website-id="<%= umami_id %>"></script>
    <% end %>
  </head>

  <body class="site">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="shell">
    <%= render "shared/header" %>

    <main id="contenido" class="shell__main">
      <% if flash.any? %>
        <div class="flash-stack">
          <% flash.each do |type, message| %>
            <div class="flash-message flash-message--<%= type %>" role="status"><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>

      <%= render "shared/footer" %>
    </main>
    </div>

    <%= render "shared/whatsapp_button" %>
  </body>
</html>
