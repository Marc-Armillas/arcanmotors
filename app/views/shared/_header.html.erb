<% nav_links = [["Coches en stock", cars_path], ["Nosotros", about_us_path]] %>
<header class="site-header <%= "site-header--dark" if content_for?(:header_dark) %>" id="site-header">
  <div class="site-header__bar wrap">
    <a href="<%= root_path %>" class="wordmark" aria-label="ArCan Motors, inicio">ArCan Motors</a>

    <nav class="site-nav" aria-label="Principal">
      <% nav_links.each do |label, path| %>
        <a href="<%= path %>" class="site-nav__link" <%= 'aria-current="page"'.html_safe if current_page?(path) %>><%= label %></a>
      <% end %>
    </nav>

    <% if user_signed_in? %>
      <%= link_to "Salir", destroy_user_session_path, method: :delete, data: { confirm: "¿Cerrar sesión?" }, class: "btn btn--outline btn--small site-header__cta" %>
    <% else %>
      <a href="<%= whatsapp_url %>" class="btn btn--dark btn--small site-header__cta" target="_blank" rel="noopener">Contactar</a>
    <% end %>

    <button type="button" id="mobile-menu-button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Abrir menú</span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Menú móvil" hidden>
    <% nav_links.each do |label, path| %>
      <a href="<%= path %>" class="mobile-menu__link"><%= label %></a>
    <% end %>
    <a href="<%= whatsapp_url %>" class="btn btn--dark btn--large mobile-menu__cta" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
  </nav>
</header>
