<% seo title: "Contacto", description: "Escríbenos para preguntar por cualquier Porsche del stock o contarnos qué coche buscas." %>

<header class="page-head wrap">
  <h1 class="display-1">Contacto</h1>
  <p class="lead">Pregunta por un coche concreto o cuéntanos qué Porsche buscas. Te respondemos lo antes posible.</p>
</header>

<div class="wrap">
  <%= form_with model: @contact_request, url: contact_request_path, method: :post, local: true, class: "form" do |f| %>
    <%= f.hidden_field :car_id %>
    <div class="form__row">
      <div class="field">
        <%= f.label :name, "Nombre" %>
        <%= f.text_field :name, required: true, autocomplete: "name" %>
      </div>
      <div class="field">
        <%= f.label :phone, "Teléfono (opcional)" %>
        <%= f.telephone_field :phone, autocomplete: "tel" %>
      </div>
    </div>
    <div class="field">
      <%= f.label :email, "Correo electrónico" %>
      <%= f.email_field :email, required: true, autocomplete: "email" %>
    </div>
    <div class="field">
      <%= f.label :subject, "Asunto" %>
      <%= f.text_field :subject, required: true %>
    </div>
    <div class="field">
      <%= f.label :message, "Mensaje" %>
      <%= f.text_area :message, rows: 6, required: true %>
    </div>
    <%= f.submit "Enviar mensaje", class: "btn btn--red btn--large" %>
  <% end %>
</div>
