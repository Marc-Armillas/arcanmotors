<% content_for :header_overlay, true %>
<% content_for :head do %>
  <link rel="preload" as="image" type="image/webp"
        imagesrcset="<%= image_path("hero_911_niebla_1200.webp") %> 1200w, <%= image_path("hero_911_niebla.webp") %> 2400w" imagesizes="100vw">
<% end %>

<%# Photos: Unsplash License (images.unsplash.com photo-1696421556654, photo-1759189199538, photo-1601465621041, photo-1748944187123) %>
<section class="hero" aria-labelledby="hero-title">
  <picture>
    <source type="image/webp" srcset="<%= image_path("hero_911_niebla_1200.webp") %> 1200w, <%= image_path("hero_911_niebla.webp") %> 2400w" sizes="100vw">
    <img class="hero__image" src="<%= image_path("hero_911_niebla.jpg") %>"
         srcset="<%= image_path("hero_911_niebla_1200.jpg") %> 1200w, <%= image_path("hero_911_niebla.jpg") %> 2400w" sizes="100vw"
         alt="Porsche 911 clásico con decoración Martini junto a una granja en una mañana de niebla" width="2400" height="1666" fetchpriority="high">
  </picture>
  <div class="hero__content wrap">
    <h1 id="hero-title" class="hero__title">Porsche de ocasión.<br>Revisados a fondo.</h1>
    <a href="<%= cars_path %>" class="btn btn--glass">
      <%= @stock_count.positive? ? "Ver los #{@stock_count} coches en stock" : "Ver coches en stock" %>
    </a>
  </div>
  <a href="#descubre" class="hero__down" aria-label="Bajar al contenido">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v13M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
  </a>
</section>

<section class="section section--light" id="descubre" aria-labelledby="intro-title">
  <div class="wrap">
    <div class="teasers">
      <a href="<%= cars_path %>" class="teaser">
        <% if (car = @cars.first) && (image = car.images.first) %>
          <%= car_image_tag image, :card, alt: "", sizes: "(min-width: 760px) 340px, 100vw" %>
        <% end %>
        <span class="teaser__label">Coches en stock</span>
        <span class="arrow-button"><%= arrow_icon %></span>
      </a>
      <a href="<%= about_us_path %>" class="teaser">
        <picture>
          <source type="image/webp" srcset="<%= image_path("taller_930_600.webp") %> 600w, <%= image_path("taller_930_1200.webp") %> 1200w" sizes="(min-width: 760px) 340px, 100vw">
          <img src="<%= image_path("taller_930_600.jpg") %>" srcset="<%= image_path("taller_930_600.jpg") %> 600w, <%= image_path("taller_930_1200.jpg") %> 1200w" sizes="(min-width: 760px) 340px, 100vw" alt="" loading="lazy" decoding="async">
        </picture>
        <span class="teaser__label">Nuestro taller</span>
        <span class="arrow-button"><%= arrow_icon %></span>
      </a>
      <a <%= track_contact("whatsapp", "home-tarjeta") %> href="<%= whatsapp_url("Hola, estoy buscando un Porsche.") %>" class="teaser" target="_blank" rel="noopener">
        <picture>
          <source type="image/webp" srcset="<%= image_path("nosotros_964_600.webp") %> 600w, <%= image_path("nosotros_964_1200.webp") %> 1200w" sizes="(min-width: 760px) 340px, 100vw">
          <img src="<%= image_path("nosotros_964_600.jpg") %>" srcset="<%= image_path("nosotros_964_600.jpg") %> 600w, <%= image_path("nosotros_964_1200.jpg") %> 1200w" sizes="(min-width: 760px) 340px, 100vw" alt="" loading="lazy" decoding="async">
        </picture>
        <span class="teaser__label">¿Buscas un modelo concreto?</span>
        <span class="arrow-button"><%= arrow_icon %></span>
      </a>
    </div>
    <h2 id="intro-title" class="statement">Tu próximo Porsche empieza aquí.</h2>
  </div>
</section>

<section class="section section--dark" aria-labelledby="stock-title">
  <div class="wrap">
    <div class="section__head">
      <h2 id="stock-title" class="heading-2">Recién llegados</h2>
      <a href="<%= cars_path %>" class="link-arrow">Ver todo el stock <%= arrow_icon %></a>
    </div>
    <% if @cars.any? %>
      <div class="model-grid">
        <% @cars.each do |car| %>
          <%= render "components/car_card", car: car %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p>Estamos preparando los próximos coches. Cuéntanos qué Porsche buscas y te avisamos cuando entre.</p>
        <a <%= track_contact("whatsapp", "home-sin-stock") %> href="<%= whatsapp_url("Hola, estoy buscando un Porsche.") %>" class="btn btn--light" target="_blank" rel="noopener">Contarnos qué buscas</a>
      </div>
    <% end %>
  </div>
</section>

<section class="banner" aria-labelledby="workshop-title">
  <picture>
    <source type="image/webp" srcset="<%= image_path("taller_930_1200.webp") %> 1200w, <%= image_path("taller_930.webp") %> 1600w" sizes="100vw">
    <img class="banner__image" src="<%= image_path("taller_930_1200.jpg") %>" srcset="<%= image_path("taller_930_1200.jpg") %> 1200w, <%= image_path("taller_930.jpg") %> 1600w" sizes="100vw" alt="Porsche 930 rojo en un taller con pósters de carreras" loading="lazy" decoding="async">
  </picture>
  <div class="banner__content wrap">
    <h2 id="workshop-title" class="heading-1">Pasa por el taller antes que por la exposición.</h2>
    <p>Llevamos desde el año 2000 reparando y preparando coches.</p>
  </div>
</section>

<section class="section section--light" aria-labelledby="process-title">
  <div class="wrap">
    <h2 id="process-title" class="heading-2 center">Así llega cada coche a la venta</h2>
    <ol class="steps">
      <li class="step">
        <h3>Lo elegimos</h3>
        <p>Solo unidades con mantenimiento documentado y kilometraje verificable. Si algo no cuadra, no entra.</p>
      </li>
      <li class="step">
        <h3>Lo revisamos</h3>
        <p>Mecánica, electrónica, frenos y carrocería. Lo que necesita atención se repara antes de la venta.</p>
      </li>
      <li class="step">
        <h3>Te lo enseñamos tal cual es</h3>
        <p>Fotos reales, ficha completa y respuestas directas, por WhatsApp o en persona.</p>
      </li>
    </ol>
  </div>
</section>

<section class="section section--dark" aria-labelledby="cta-title">
  <div class="wrap cta">
    <h2 id="cta-title" class="heading-1">¿Buscas un Porsche concreto?</h2>
    <p class="lead">Dinos modelo, año y presupuesto. Si no lo tenemos, te avisamos cuando entre uno que encaje.</p>
    <a <%= track_contact("whatsapp", "home-final") %> href="<%= whatsapp_url("Hola, busco un Porsche: ") %>" class="btn btn--light btn--large" target="_blank" rel="noopener">Contarnos qué buscas</a>
  </div>
</section>
