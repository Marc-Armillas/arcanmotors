<%
  title = @current_category ? "Porsche #{@current_category.name} de ocasión en venta" : "Porsche de ocasión en venta"
  seo title: title,
      description: "#{@cars.size} Porsche de ocasión en stock#{" de la gama #{@current_category.name}" if @current_category}: precio, kilómetros y ficha completa de cada coche, revisado en nuestro taller.",
      canonical: @current_category ? "#{site_base_url}#{cars_path(categoria: params[:categoria])}" : "#{site_base_url}#{cars_path}"
%>
<% content_for :head do %>
  <%= breadcrumbs_json_ld([["Inicio", "#{site_base_url}/"], ["Coches en stock", "#{site_base_url}#{cars_path}"]]) %>
<% end %>

<header class="page-head wrap center">
  <h1 class="display-1"><%= title %>.</h1>
  <p class="lead">
    <%= pluralize(@cars.size, "coche disponible", plural: "coches disponibles") %>, todos revisados en nuestro taller antes de salir a la venta.
  </p>

  <% if @categories.size > 1 %>
    <nav class="filter-chips" aria-label="Filtrar por carrocería">
      <a href="<%= cars_path %>" class="chip" <%= 'aria-current="page"'.html_safe unless @current_category %>>Todos</a>
      <% @categories.each do |category| %>
        <a href="<%= cars_path(categoria: category.name.parameterize) %>" class="chip" <%= 'aria-current="page"'.html_safe if category == @current_category %>><%= category.name %></a>
      <% end %>
    </nav>
  <% end %>
</header>

<section class="section section--tight wrap" aria-label="Listado de coches">
  <% if @cars.any? %>
    <div class="car-grid">
      <% @cars.each_with_index do |car, index| %>
        <%= render "components/car_card", car: car, heading: :h2, eager: index < 3 %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p>No hay coches de esta gama en stock ahora mismo. Dinos qué buscas y te avisamos cuando entre uno.</p>
      <a href="<%= whatsapp_url("Hola, busco un Porsche: ") %>" class="btn btn--dark" target="_blank" rel="noopener">Contarnos qué buscas</a>
    </div>
  <% end %>
</section>
