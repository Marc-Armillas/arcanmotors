<% content_for :header_overlay, true %>
<% content_for :head do %>
  <link rel="preload" as="image" type="image/webp"
        imagesrcset="<%= image_path("hero_911_niebla_1200.webp") %> 1200w, <%= image_path("hero_911_niebla.webp") %> 2400w" imagesizes="100vw">
<% end %>

<%# Photos: Unsplash License (images.unsplash.com photo-1696421556654, photo-1759189199538, photo-1601465621041) %>
<section class="hero" aria-labelledby="hero-title">
  <picture>
    <source type="image/webp" srcset="<%= image_path("hero_911_niebla_1200.webp") %> 1200w, <%= image_path("hero_911_niebla.webp") %> 2400w" sizes="100vw">
    <img class="hero__image" src="<%= image_path("hero_911_niebla.jpg") %>"
         srcset="<%= image_path("hero_911_niebla_1200.jpg") %> 1200w, <%= image_path("hero_911_niebla.jpg") %> 2400w" sizes="100vw"
         alt="Porsche 911 clásico con decoración Martini junto a una granja en una mañana de niebla" width="2400" height="1666" fetchpriority="high">
  </picture>
  <div class="hero__content wrap">
    <h1 id="hero-title" class="display-hero hero__title">Porsche elegidos uno a uno.</h1>
    <p class="hero__lead">
      Seleccionamos cada coche por su historial y lo preparamos en nuestro taller antes de ponerlo a la venta. Solo Porsche, desde el año 2000.
    </p>
    <div class="hero__actions">
      <a href="<%= cars_path %>" class="btn btn--light btn--large">
        <%= @stock_count.positive? ? "Ver los #{@stock_count} coches en stock" : "Ver coches en stock" %>
      </a>
      <a href="<%= whatsapp_url("Hola, estoy buscando un Porsche.") %>" class="btn btn--frame btn--large" target="_blank" rel="noopener">Hablar por WhatsApp</a>
    </div>
  </div>
  <p class="hero__caption">Cada coche, con su historia completa.</p>
</section>

<section class="section" aria-labelledby="stock-title">
  <div class="wrap">
    <div class="section__head">
      <h2 id="stock-title" class="display-2">Recién llegados</h2>
      <a href="<%= cars_path %>" class="text-link">Ver todo el stock</a>
    </div>

    <% if @cars.any? %>
      <div class="car-grid">
        <% @cars.first(6).each do |car| %>
          <%= render "components/car_card", car: car %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p>Estamos preparando los próximos coches. Cuéntanos qué Porsche buscas y te avisamos cuando entre.</p>
        <a href="<%= whatsapp_url("Hola, estoy buscando un Porsche.") %>" class="btn btn--frame" target="_blank" rel="noopener">Contarnos qué buscas</a>
      </div>
    <% end %>
  </div>
</section>

<section class="section section--surface" aria-labelledby="workshop-title">
  <div class="wrap feature">
    <div class="feature__media">
      <picture>
        <source type="image/webp" srcset="<%= image_path("taller_930.webp") %>">
        <img src="<%= image_path("taller_930.jpg") %>" alt="Porsche 930 rojo en un taller con pósters de carreras" width="1600" height="1066" loading="lazy" decoding="async">
      </picture>
    </div>
    <div class="feature__body">
      <h2 id="workshop-title" class="display-2">Pasa por el taller antes que por la exposición.</h2>
      <p class="lead">Llevamos desde el año 2000 reparando y preparando coches. Esa experiencia es la que aplicamos a cada Porsche antes de venderlo.</p>
      <ol class="steps">
        <li>
          <h3>Lo elegimos</h3>
          <p>Solo unidades con mantenimiento documentado y kilometraje verificable. Si algo no cuadra, no entra.</p>
        </li>
        <li>
          <h3>Lo revisamos</h3>
          <p>Mecánica, electrónica, frenos y carrocería. Lo que necesita atención se repara antes de la venta.</p>
        </li>
        <li>
          <h3>Te lo enseñamos tal cual es</h3>
          <p>Fotos reales, ficha completa y respuestas directas, por WhatsApp o en persona.</p>
        </li>
      </ol>
    </div>
  </div>
</section>

<section class="section statement" aria-label="Nuestra forma de trabajar">
  <div class="wrap">
    <p class="statement__quote">No vendemos un coche que no nos llevaríamos a casa.</p>
    <p class="statement__by caps">ArCan Motors</p>
  </div>
</section>

<section class="photo-band" aria-labelledby="cta-title">
  <picture>
    <source type="image/webp" srcset="<%= image_path("nosotros_964.webp") %>">
    <img class="photo-band__image" src="<%= image_path("nosotros_964.jpg") %>" alt="" loading="lazy" decoding="async">
  </picture>
  <div class="wrap photo-band__content">
    <h2 id="cta-title" class="display-1">¿Buscas un Porsche concreto?</h2>
    <p class="lead">Dinos modelo, año y presupuesto. Si no lo tenemos, te avisamos cuando entre uno que encaje.</p>
    <div class="photo-band__actions">
      <a href="<%= whatsapp_url("Hola, busco un Porsche: ") %>" class="btn btn--red btn--large" target="_blank" rel="noopener">Contarnos qué buscas</a>
    </div>
  </div>
</section>
