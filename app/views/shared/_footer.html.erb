<footer class="site-footer">
  <a href="#contenido" class="site-footer__top">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V6M6 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
    Volver arriba
  </a>
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <a href="<%= root_path %>" class="wordmark">ArCan Motors</a>
      <p>Porsche de ocasión seleccionados y revisados en nuestro taller.</p>
    </div>

    <nav class="site-footer__col" aria-label="Web">
      <h2 class="site-footer__heading">Web</h2>
      <a href="<%= cars_path %>">Coches en stock</a>
      <a href="<%= about_us_path %>">Nosotros</a>
    </nav>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Contacto</h2>
      <a <%= track_contact("whatsapp", "pie") %> href="<%= whatsapp_url %>" target="_blank" rel="noopener">WhatsApp <%= whatsapp_phone_display %></a>
      <% if whatsapp_phone.present? %>
        <a <%= track_contact("llamada", "pie") %> href="tel:+<%= whatsapp_phone %>">Llamar</a>
      <% end %>
      <a href="mailto:info@arcanemotors.com">info@arcanemotors.com</a>
    </div>

    <nav class="site-footer__col" aria-label="Legal">
      <h2 class="site-footer__heading">Legal</h2>
      <a href="<%= legal_path %>#aviso-legal">Aviso legal</a>
      <a href="<%= legal_path %>#terminos-condiciones">Términos y condiciones</a>
      <a href="<%= cookies_policy_path %>">Política de cookies</a>
    </nav>
  </div>
  <p class="wrap site-footer__small">
    © <%= Date.current.year %> ArCan Motors. Porsche es una marca registrada de Dr. Ing. h.c. F. Porsche AG; ArCan Motors es un vendedor independiente.
  </p>
</footer>
