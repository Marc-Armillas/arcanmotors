<% nav_links = [["Inicio", root_path], ["Coches en stock", cars_path], ["Nosotros", about_us_path]] %>
<header class="sidebar" id="site-header">
  <div class="sidebar__top">
    <a href="<%= root_path %>" class="wordmark" aria-label="ArCan Motors, inicio">ArCan<br> Motors</a>
    <button type="button" id="mobile-menu-button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Abrir menú</span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>

  <div class="sidebar__panel" id="mobile-menu">
    <nav class="sidebar__nav" aria-label="Principal">
      <% nav_links.each do |label, path| %>
        <a href="<%= path %>" class="sidebar__link" <%= 'aria-current="page"'.html_safe if current_page?(path) %>><%= label %></a>
      <% end %>
    </nav>

    <div class="sidebar__contact">
      <p class="caps">Especialistas en Porsche desde 2000</p>
      <% if user_signed_in? %>
        <%= link_to "Salir", destroy_user_session_path, method: :delete, data: { confirm: "¿Cerrar sesión?" }, class: "btn btn--frame btn--block" %>
      <% else %>
        <a href="<%= whatsapp_url %>" class="btn btn--red btn--block" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
      <% end %>
      <% if whatsapp_phone.present? %>
        <a href="tel:+<%= whatsapp_phone %>" class="sidebar__phone"><%= whatsapp_phone_display %></a>
      <% end %>
    </div>
  </div>
</header>
