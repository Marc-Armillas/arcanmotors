<% nav_links = [["Inicio", root_path], ["Coches en stock", cars_path], ["Nosotros", about_us_path]] %>
<header class="site-header <%= "site-header--overlay" if content_for?(:header_overlay) %>" id="site-header">
  <div class="site-header__bar">
    <button type="button" id="mobile-menu-button" class="site-header__menu" aria-expanded="false" aria-controls="menu-drawer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      <span>Menú</span>
    </button>

    <a href="<%= root_path %>" class="wordmark" aria-label="ArCan Motors, inicio">ArCan Motors</a>

    <div class="site-header__tools">
      <% if whatsapp_phone.present? %>
        <a <%= track_contact("llamada", "cabecera") %> href="tel:+<%= whatsapp_phone %>" class="site-header__icon" aria-label="Llamar al <%= whatsapp_phone_display %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h2.6l1.4 4-1.8 1.3a11 11 0 0 0 6.4 6.4l1.3-1.8 4 1.4v2.6a1.6 1.6 0 0 1-1.7 1.6C10.4 18.4 5.6 13.6 5 5.2a1.6 1.6 0 0 1 1.6-1.7Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        </a>
      <% end %>
      <a <%= track_contact("whatsapp", "cabecera") %> href="<%= whatsapp_url %>" class="site-header__icon" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 8.6c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.6 1.5c.1.2 0 .4-.1.6l-.5.6c.6 1.1 1.5 2 2.6 2.6l.6-.5c.2-.1.4-.2.6-.1l1.5.6c.3.1.4.3.4.5v.5c0 .3 0 .5-.4.7-.5.3-1.3.5-2 .3a8 8 0 0 1-5.1-5.1c-.2-.7 0-1.5.3-2Z" fill="currentColor"/></svg>
      </a>
    </div>
  </div>

  <div class="menu-drawer" id="menu-drawer" hidden>
    <div class="menu-drawer__panel" role="dialog" aria-modal="true" aria-label="Menú">
      <button type="button" class="menu-drawer__close js-menu-close" aria-label="Cerrar menú">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
      <nav class="menu-drawer__nav" aria-label="Principal">
        <% nav_links.each do |label, path| %>
          <a href="<%= path %>" class="menu-drawer__link" <%= 'aria-current="page"'.html_safe if current_page?(path) %>>
            <span><%= label %></span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          </a>
        <% end %>
      </nav>
      <div class="menu-drawer__contact">
        <p>¿Hablamos? Te respondemos por WhatsApp.</p>
        <% if user_signed_in? %>
          <%= link_to "Cerrar sesión", destroy_user_session_path, method: :delete, data: { confirm: "¿Cerrar sesión?" }, class: "btn btn--secondary btn--block" %>
        <% end %>
        <a <%= track_contact("whatsapp", "menu") %> href="<%= whatsapp_url %>" class="btn btn--primary btn--block" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
        <% if whatsapp_phone.present? %>
          <a <%= track_contact("llamada", "menu") %> href="tel:+<%= whatsapp_phone %>" class="btn btn--secondary btn--block">Llamar al <%= whatsapp_phone_display %></a>
        <% end %>
      </div>
    </div>
    <div class="menu-drawer__scrim js-menu-close"></div>
  </div>
</header>
