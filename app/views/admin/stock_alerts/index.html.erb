<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold mb-2">Avisos de stock</h1>
  <p class="text-gray-600 mb-6">Personas que quieren que les avises cuando entre un Porsche concreto. "Encajan ahora" son los coches publicados que cumplen su modelo y presupuesto.</p>

  <% if @stock_alerts.empty? %>
    <p class="text-gray-500">Todavía no hay avisos.</p>
  <% else %>
    <div class="overflow-x-auto shadow border-b border-gray-200 sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-200 bg-white">
        <thead class="bg-gray-50">
          <tr>
            <% ["Fecha", "Nombre", "Contacto", "Busca", "Presupuesto", "Encajan ahora", "Estado", ""].each do |heading| %>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= heading %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @stock_alerts.each do |alert| %>
            <% matches = alert.matching_cars.to_a %>
            <tr class="<%= "opacity-50" if alert.handled %>">
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= alert.created_at.strftime("%d/%m/%Y") %></td>
              <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= alert.name %></td>
              <td class="px-4 py-3 text-sm text-gray-700">
                <% if alert.email.present? %><a class="underline" href="mailto:<%= alert.email %>"><%= alert.email %></a><br><% end %>
                <% if alert.whatsapp_number %>
                  <a class="text-green-700 underline" href="https://wa.me/<%= alert.whatsapp_number %>" target="_blank" rel="noopener">WhatsApp <%= alert.phone %></a>
                <% elsif alert.phone.present? %><%= alert.phone %><% end %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700">
                <%= alert.line ? "Porsche #{alert.line.name}" : "Cualquier Porsche" %>
                <% if alert.notes.present? %><div class="text-gray-500 text-xs mt-1"><%= alert.notes %></div><% end %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700 whitespace-nowrap"><%= alert.max_price ? number_to_currency(alert.max_price, unit: "€", format: "%n %u", precision: 0, delimiter: ".") : "—" %></td>
              <td class="px-4 py-3 text-sm">
                <% if matches.any? %>
                  <% matches.first(3).each do |car| %>
                    <div><%= link_to car.name, admin_car_path(car), class: "text-indigo-700 underline" %></div>
                  <% end %>
                  <% if matches.size > 3 %><div class="text-gray-500 text-xs">y <%= matches.size - 3 %> más</div><% end %>
                <% else %>
                  <span class="text-gray-400">Ninguno</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm whitespace-nowrap">
                <%= button_to alert.handled ? "Atendido ✅" : "Pendiente", admin_stock_alert_path(alert), method: :patch,
                              params: { stock_alert: { handled: !alert.handled } },
                              class: "px-3 py-1 rounded-md text-sm #{alert.handled ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800"}" %>
              </td>
              <td class="px-4 py-3 text-sm">
                <%= button_to "🗑️", admin_stock_alert_path(alert), method: :delete, form: { data: { confirm: "¿Eliminar este aviso?" } }, title: "Eliminar" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
