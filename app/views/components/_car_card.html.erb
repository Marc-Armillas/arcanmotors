<%# locals: car, heading (optional, default :h3), eager (optional) %>
<article class="car-card">
  <a href="<%= car_path(car) %>" class="car-card__link">
    <% if (image = car.images.first) %>
      <%= car_image_tag image, :card, alt: car_image_alt(car), class: "car-card__image", eager: local_assigns[:eager],
                        sizes: "(min-width: 1440px) 680px, (min-width: 760px) 46vw, 100vw" %>
    <% end %>
    <%= content_tag local_assigns.fetch(:heading, :h3), car.name, class: "car-card__title" %>
    <div class="car-card__foot">
      <div class="car-card__info">
        <ul class="chips" aria-label="Datos principales">
          <% if car.reserved? %><li class="chip chip--status">Reservado</li><% end %>
          <% if car.year %><li class="chip"><%= car.year %></li><% end %>
          <% if car.kilometers %><li class="chip"><%= car_km(car) %></li><% end %>
          <% if car.cv %><li class="chip"><%= car.cv %> CV</li><% end %>
          <% if (fuel = CarsHelper::FUEL_LABELS[car.fuel]) %><li class="chip"><%= fuel %></li><% end %>
        </ul>
        <p class="car-card__price"><%= car_price(car) %></p>
      </div>
      <span class="arrow-button"><%= arrow_icon %></span>
    </div>
  </a>
</article>
