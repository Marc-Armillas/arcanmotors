<%# locals: car, index, eager (optional) %>
<li class="car-row">
  <a href="<%= car_path(car) %>" class="car-row__link">
    <span class="car-row__lot"><%= format("%02d", index + 1) %></span>
    <div class="car-row__media">
      <% if (image = car.images.first) %>
        <img src="<%= car_image_url(image, :card) %>" alt="<%= car_image_alt(car) %>" width="960" height="640"
             loading="<%= local_assigns[:eager] ? "eager" : "lazy" %>" decoding="async">
      <% end %>
    </div>
    <div class="car-row__name">
      <h2 class="car-row__title"><%= car.name %></h2>
      <% if car.reserved? %><span class="badge">Reservado</span><% end %>
    </div>
    <span class="car-row__spec"><span class="car-row__label">Año</span><%= car.year %></span>
    <span class="car-row__spec"><span class="car-row__label">Kilómetros</span><%= car_km(car) %></span>
    <span class="car-row__spec"><span class="car-row__label">Potencia</span><%= "#{car.cv} CV" if car.cv %></span>
    <span class="car-row__price"><%= car_price(car) %></span>
  </a>
</li>
