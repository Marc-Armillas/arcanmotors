<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold mb-2">Coches ofrecidos ("Vende tu Porsche")</h1>
  <p class="text-gray-600 mb-6">Particulares que quieren vendernos su Porsche.</p>

  <% if @sell_requests.empty? %>
    <p class="text-gray-500">Todavía no hay solicitudes.</p>
  <% else %>
    <div class="overflow-x-auto shadow border-b border-gray-200 sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-200 bg-white">
        <thead class="bg-gray-50">
          <tr>
            <% ["Fecha", "Foto", "Coche", "Año / km", "Pide", "Nombre", "Estado", ""].each do |heading| %>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= heading %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @sell_requests.each do |request| %>
            <tr class="<%= "opacity-50" if request.handled %>">
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= request.created_at.strftime("%d/%m/%Y") %></td>
              <td class="px-4 py-3">
                <% if (photo = request.photos.first) && photo.variable? %>
                  <%= image_tag photo.variant(resize_to_fill: [ 96, 72 ]), class: "rounded", alt: "" %>
                <% else %>
                  <span class="text-gray-400 text-xs">Sin fotos</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm font-medium"><%= link_to request.model, admin_sell_request_path(request), class: "text-indigo-700 underline" %></td>
              <td class="px-4 py-3 text-sm text-gray-700 whitespace-nowrap"><%= request.year || "—" %> / <%= request.kilometers ? "#{number_with_delimiter(request.kilometers, delimiter: ".")} km" : "—" %></td>
              <td class="px-4 py-3 text-sm text-gray-700 whitespace-nowrap"><%= request.asking_price ? number_to_currency(request.asking_price, unit: "€", format: "%n %u", precision: 0, delimiter: ".") : "—" %></td>
              <td class="px-4 py-3 text-sm text-gray-900"><%= request.name %></td>
              <td class="px-4 py-3 text-sm whitespace-nowrap">
                <%= button_to request.handled ? "Atendido ✅" : "Pendiente", admin_sell_request_path(request), method: :patch,
                              params: { sell_request: { handled: !request.handled } },
                              class: "px-3 py-1 rounded-md text-sm #{request.handled ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800"}" %>
              </td>
              <td class="px-4 py-3 text-sm">
                <%= button_to "🗑️", admin_sell_request_path(request), method: :delete, form: { data: { confirm: "¿Eliminar esta solicitud y sus fotos?" } }, title: "Eliminar" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
