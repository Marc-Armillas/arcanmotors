<% content_for :head do %>
  <link rel="preload" as="image" type="image/webp"
        imagesrcset="<%= image_path("hero_911_niebla_1200.webp") %> 1200w, <%= image_path("hero_911_niebla.webp") %> 2400w" imagesizes="(min-width: 1000px) 80vw, 100vw">
<% end %>

<%# Photos: Unsplash License (images.unsplash.com photo-1696421556654, photo-1759189199538, photo-1601465621041) %>
<section class="cover" aria-labelledby="hero-title">
  <picture>
    <source type="image/webp" srcset="<%= image_path("hero_911_niebla_1200.webp") %> 1200w, <%= image_path("hero_911_niebla.webp") %> 2400w" sizes="(min-width: 1000px) 80vw, 100vw">
    <img class="cover__image" src="<%= image_path("hero_911_niebla.jpg") %>"
         srcset="<%= image_path("hero_911_niebla_1200.jpg") %> 1200w, <%= image_path("hero_911_niebla.jpg") %> 2400w" sizes="(min-width: 1000px) 80vw, 100vw"
         alt="Porsche 911 clásico con decoración Martini junto a una granja en una mañana de niebla" width="2400" height="1666" fetchpriority="high">
  </picture>
  <div class="cover__content">
    <h1 id="hero-title" class="display-hero">Porsche elegidos uno a uno.</h1>
    <p class="cover__lead">
      Seleccionamos cada coche por su historial y lo preparamos en nuestro taller antes de ponerlo a la venta.
    </p>
    <a href="#exposicion" class="cover__scroll caps">
      <%= @cars.any? ? "Recorre la exposición" : "Conócenos" %>
    </a>
  </div>
</section>

<div id="exposicion">
  <% @cars.each_with_index do |car, index| %>
    <% image = car.images.first %>
    <section class="showcase" aria-labelledby="car-<%= car.id %>">
      <% if image %>
        <img class="showcase__image" src="<%= car_image_url(image, :gallery) %>" alt="<%= car_image_alt(car) %>"
             width="1800" height="1350" loading="<%= index.zero? ? "eager" : "lazy" %>" decoding="async">
      <% end %>
      <div class="showcase__card">
        <p class="showcase__lot caps">Lote <%= format("%02d", index + 1) %> de <%= format("%02d", @cars.size) %></p>
        <h2 id="car-<%= car.id %>" class="showcase__title"><%= car.name %></h2>
        <% if car.reserved? %><span class="badge">Reservado</span><% end %>
        <dl class="showcase__specs">
          <% if car.year %><div><dt>Año</dt><dd><%= car.year %></dd></div><% end %>
          <% if car.kilometers %><div><dt>Kilómetros</dt><dd><%= number_with_delimiter(car.kilometers, delimiter: ".") %></dd></div><% end %>
          <% if car.cv %><div><dt>Potencia</dt><dd><%= car.cv %> CV</dd></div><% end %>
        </dl>
        <div class="showcase__foot">
          <p class="showcase__price"><%= car_price(car) %></p>
          <a href="<%= car_path(car) %>" class="btn btn--light">Ver el coche</a>
        </div>
      </div>
    </section>
  <% end %>
</div>

<section class="index-band" aria-labelledby="stock-title">
  <div class="wrap index-band__inner">
    <h2 id="stock-title" class="display-1">
      <%= @stock_count.positive? ? "#{@stock_count} Porsche en stock ahora mismo." : "Preparando los próximos coches." %>
    </h2>
    <div>
      <p class="lead">Consulta el catálogo completo con precio, kilómetros y ficha técnica de cada coche.</p>
      <a href="<%= cars_path %>" class="btn btn--frame btn--large">Ver el catálogo completo</a>
    </div>
  </div>
</section>

<section class="section section--surface" aria-labelledby="workshop-title">
  <div class="wrap feature">
    <div class="feature__media">
      <picture>
        <source type="image/webp" srcset="<%= image_path("taller_930.webp") %>">
        <img src="<%= image_path("taller_930.jpg") %>" alt="Porsche 930 rojo en un taller con pósters de carreras" width="1600" height="1066" loading="lazy" decoding="async">
      </picture>
    </div>
    <div class="feature__body">
      <h2 id="workshop-title" class="display-2">Pasa por el taller antes que por la exposición.</h2>
      <p class="lead">Llevamos desde el año 2000 reparando y preparando coches. Esa experiencia es la que aplicamos a cada Porsche antes de venderlo.</p>
      <ol class="steps">
        <li>
          <h3>Lo elegimos</h3>
          <p>Solo unidades con mantenimiento documentado y kilometraje verificable. Si algo no cuadra, no entra.</p>
        </li>
        <li>
          <h3>Lo revisamos</h3>
          <p>Mecánica, electrónica, frenos y carrocería. Lo que necesita atención se repara antes de la venta.</p>
        </li>
        <li>
          <h3>Te lo enseñamos tal cual es</h3>
          <p>Fotos reales, ficha completa y respuestas directas, por WhatsApp o en persona.</p>
        </li>
      </ol>
    </div>
  </div>
</section>

<section class="photo-band" aria-labelledby="cta-title">
  <picture>
    <source type="image/webp" srcset="<%= image_path("nosotros_964.webp") %>">
    <img class="photo-band__image" src="<%= image_path("nosotros_964.jpg") %>" alt="" loading="lazy" decoding="async">
  </picture>
  <div class="wrap photo-band__content">
    <h2 id="cta-title" class="display-1">¿Buscas un Porsche concreto?</h2>
    <p class="lead">Dinos modelo, año y presupuesto. Si no lo tenemos, te avisamos cuando entre uno que encaje.</p>
    <div class="photo-band__actions">
      <a href="<%= whatsapp_url("Hola, busco un Porsche: ") %>" class="btn btn--red btn--large" target="_blank" rel="noopener">Contarnos qué buscas</a>
    </div>
  </div>
</section>
