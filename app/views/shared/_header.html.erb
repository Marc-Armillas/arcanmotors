<header class="site-header <%= "site-header--overlay" if content_for?(:header_overlay) %>" id="site-header">
  <div class="site-header__bar wrap">
    <nav class="site-nav" aria-label="Principal">
      <a href="<%= cars_path %>" class="site-nav__link site-nav__link--framed" <%= 'aria-current="page"'.html_safe if current_page?(cars_path) %>>Coches en stock</a>
      <a href="<%= about_us_path %>" class="site-nav__link" <%= 'aria-current="page"'.html_safe if current_page?(about_us_path) %>>Nosotros</a>
    </nav>

    <a href="<%= root_path %>" class="wordmark" aria-label="ArCan Motors, inicio">ArCan Motors</a>

    <div class="site-header__end">
      <% if user_signed_in? %>
        <%= link_to "Salir", destroy_user_session_path, method: :delete, data: { confirm: "¿Cerrar sesión?" }, class: "site-nav__link" %>
      <% else %>
        <a href="<%= whatsapp_url %>" class="site-nav__link" target="_blank" rel="noopener">Contacto</a>
      <% end %>
    </div>

    <button type="button" id="mobile-menu-button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Abrir menú</span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Menú móvil" hidden>
    <a href="<%= cars_path %>" class="mobile-menu__link">Coches en stock</a>
    <a href="<%= about_us_path %>" class="mobile-menu__link">Nosotros</a>
    <a href="<%= whatsapp_url %>" class="btn btn--red btn--large mobile-menu__cta" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
  </nav>
</header>
